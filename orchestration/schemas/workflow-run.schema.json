{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Customer Data Cleaner run manifest",
  "type": "object",
  "required": ["runId", "startedAt", "workflowVersion", "schemaVersion", "ruleVersion", "input", "phases", "artifacts", "finalStatus"],
  "properties": {
    "runId": { "type": "string", "pattern": "^[A-Za-z0-9_-]+$" },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": "string", "format": "date-time" },
    "workflowVersion": { "type": "string" },
    "schemaVersion": { "type": "string" },
    "ruleVersion": { "type": "string" },
    "input": { "type": "object", "required": ["sha256", "bytes"], "properties": { "sha256": { "type": "string" }, "bytes": { "type": "integer", "minimum": 0 } } },
    "phases": { "type": "object" },
    "artifacts": { "type": "array", "items": { "type": "string" } },
    "finalStatus": { "enum": ["RUNNING", "NEEDS_REVIEW", "READY_FOR_REVIEW", "FAILED"] }
  }
}
